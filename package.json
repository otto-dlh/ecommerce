{
  "name": "tienda-segura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8888 --strictPort",
    "dev:netlify": "node -e \"require('fs').rmSync('dist/_headers',{force:true})\" && pnpm --package=netlify-cli@27 dlx netlify dev",
    "dev:web": "vite",
    "serve": "pnpm --package=netlify-cli@27 dlx netlify serve",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:insforge": "node --env-file=.env --test tests/contract/insforge.itest.mjs",
    "seed": "node --env-file=.env tooling/scripts/seed.mjs",
    "check:permissions": "node tooling/scripts/check-permissions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@insforge/sdk": "^1.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  }
}
